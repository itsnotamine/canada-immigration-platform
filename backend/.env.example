# Clé utilisée pour signer les jetons de session. Change-la en production.
APP_SECRET_KEY=change-moi-en-production

# Requis pour la correction IA des productions écrites/orales (routers/tcf.py).
# Sans cette clé, POST /api/tcf/expression/submit retourne une erreur claire (503)
# plutôt que de planter.
# ANTHROPIC_API_KEY=sk-ant-...

# À utiliser plus tard si tu branches Stripe (voir routers/payments.py)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
